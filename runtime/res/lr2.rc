// Windows resources: icon (from the original game, see tools/extract_icon.py),
// manifest and version information.
#include <winver.h>

1 ICON "lr2.ico"
1 24 "lr2.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "LEGO Racers 2 (native port)"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "lr2"
      VALUE "OriginalFilename", "lr2.exe"
      VALUE "ProductName", "LEGO Racers 2 native port"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
